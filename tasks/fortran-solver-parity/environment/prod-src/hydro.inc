C     ------------------------------------------------------------------
C     HYDRO 2.3  SHARED DECLARATIONS
C     ------------------------------------------------------------------
      INTEGER MAXN, MAXL, MAXP, MAXM, MAXT
      PARAMETER (MAXN=100, MAXL=150, MAXP=10, MAXM=24, MAXT=16)
      DOUBLE PRECISION GRAV, PI, VISC, GMIN, QZERO
      PARAMETER (GRAV=9.80665D0, PI=3.14159265358979D0)
      PARAMETER (VISC=1.0D-6, GMIN=1.0D-4, QZERO=1.0D-6)
C
C     NODES
      INTEGER NNODE, NRES, NTYP(MAXN), NPAT(MAXN), NORD(MAXN)
      INTEGER NLIN(MAXN)
      LOGICAL NISO(MAXN)
      CHARACTER*8 NID(MAXN), NPID(MAXN)
      DOUBLE PRECISION ELEV(MAXN), BDEM(MAXN), DEM(MAXN), HEAD(MAXN)
      COMMON /NODI/ NNODE, NRES, NTYP, NPAT, NORD, NLIN, NISO
      COMMON /NODC/ NID, NPID
      COMMON /NODR/ ELEV, BDEM, DEM, HEAD
C
C     LINKS
      INTEGER NLINK, LTYP(MAXL), LN1(MAXL), LN2(MAXL), LSTA(MAXL)
      INTEGER LLIN(MAXL)
      CHARACTER*8 LID(MAXL), LNM1(MAXL), LNM2(MAXL)
      DOUBLE PRECISION LLEN(MAXL), LDIA(MAXL), LRGH(MAXL), LKM(MAXL)
      DOUBLE PRECISION PH0(MAXL), PQM(MAXL), Q(MAXL), FF(MAXL)
      COMMON /LNKI/ NLINK, LTYP, LN1, LN2, LSTA, LLIN
      COMMON /LNKC/ LID, LNM1, LNM2
      COMMON /LNKR/ LLEN, LDIA, LRGH, LKM, PH0, PQM, Q, FF
C
C     DEMAND PATTERNS
      INTEGER NPATT, PLEN(MAXP)
      CHARACTER*8 PID(MAXP)
      DOUBLE PRECISION PMUL(MAXM,MAXP)
      COMMON /PATI/ NPATT, PLEN
      COMMON /PATC/ PID
      COMMON /PATR/ PMUL
C
C     OPTIONS AND RUN STATE
      INTEGER MAXIT, IFRIC, IUNIT, NSTEP, NERR, NWARN, ITERS, LINENO
      LOGICAL CONVGD, ENDSEN
      DOUBLE PRECISION TOL, HSTEP
      CHARACTER*60 TITLE
      COMMON /OPTI/ MAXIT, IFRIC, IUNIT, NSTEP, NERR, NWARN, ITERS,
     &              LINENO, CONVGD, ENDSEN
      COMMON /OPTR/ TOL, HSTEP
      COMMON /OPTC/ TITLE
C
C     UNIT FACTORS (USER UNIT TO SI)
      DOUBLE PRECISION UL, UD, UQ, UH, UR, UP
      COMMON /UNIT/ UL, UD, UQ, UH, UR, UP
C
C     CARD TOKENS
      INTEGER NTOK, TPOS(MAXT)
      CHARACTER*80 CARD
      CHARACTER*40 TOK(MAXT)
      COMMON /TOKI/ NTOK, TPOS
      COMMON /TOKC/ CARD, TOK
