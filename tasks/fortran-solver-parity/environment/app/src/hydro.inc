C     ------------------------------------------------------------------
C     HYDRO 1.8  COMMON BLOCKS
C     ------------------------------------------------------------------
      INTEGER MXNODE, MXLINK
      PARAMETER (MXNODE=100, MXLINK=150)
      DOUBLE PRECISION G, PI, VISC, GMIN
      PARAMETER (G=9.81D0, PI=3.14159265358979D0, VISC=1.0D-6)
      PARAMETER (GMIN=1.0D-4)
C
C     JUNCTIONS AND RESERVOIRS
      INTEGER NNODES, NODTYP(MXNODE)
      CHARACTER*6 NODEID(MXNODE)
      DOUBLE PRECISION ZNODE(MXNODE), QDEM(MXNODE), HNODE(MXNODE)
      COMMON /NODES1/ NNODES, NODTYP
      COMMON /NODES2/ NODEID
      COMMON /NODES3/ ZNODE, QDEM, HNODE
C
C     PIPES AND PUMPS
      INTEGER NLINKS, LNKTYP(MXLINK), INODE(MXLINK), JNODE(MXLINK)
      CHARACTER*6 LINKID(MXLINK)
      DOUBLE PRECISION XLEN(MXLINK), DIAM(MXLINK), ROUGH(MXLINK)
      DOUBLE PRECISION XMINOR(MXLINK), HPUMP(MXLINK), FLOW(MXLINK)
      DOUBLE PRECISION FRICT(MXLINK)
      COMMON /LINKS1/ NLINKS, LNKTYP, INODE, JNODE
      COMMON /LINKS2/ LINKID
      COMMON /LINKS3/ XLEN, DIAM, ROUGH, XMINOR, HPUMP, FLOW, FRICT
C
C     RUN CONTROL
      INTEGER ITMAX, NITER, LINE, METHOD
      LOGICAL CONVRG
      DOUBLE PRECISION ACCUR
      CHARACTER*40 TITLE
      COMMON /CNTRL1/ ITMAX, NITER, LINE, METHOD, CONVRG
      COMMON /CNTRL2/ ACCUR
      COMMON /CNTRL3/ TITLE
C
C     FIELDS OF THE CURRENT CARD
      INTEGER NFLD
      CHARACTER*80 FIELD(12)
      COMMON /CARD1/ NFLD
      COMMON /CARD2/ FIELD
